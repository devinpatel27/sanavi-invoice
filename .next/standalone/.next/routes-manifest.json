{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/auth/[...nextauth]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPnextauth": "nxtPnextauth"
      },
      "namedRegex": "^/api/auth/(?<nxtPnextauth>.+?)(?:/)?$"
    },
    {
      "page": "/api/invoices/[id]/file",
      "regex": "^/api/invoices/([^/]+?)/file(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/invoices/(?<nxtPid>[^/]+?)/file(?:/)?$"
    },
    {
      "page": "/invoices/[id]/review",
      "regex": "^/invoices/([^/]+?)/review(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/invoices/(?<nxtPid>[^/]+?)/review(?:/)?$"
    },
    {
      "page": "/projects/[id]",
      "regex": "^/projects/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/projects/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin/activity",
      "regex": "^/admin/activity(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/activity(?:/)?$"
    },
    {
      "page": "/admin/errors",
      "regex": "^/admin/errors(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/errors(?:/)?$"
    },
    {
      "page": "/admin/settings",
      "regex": "^/admin/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/settings(?:/)?$"
    },
    {
      "page": "/api/admin/export",
      "regex": "^/api/admin/export(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/admin/export(?:/)?$"
    },
    {
      "page": "/api/invoices/upload",
      "regex": "^/api/invoices/upload(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/invoices/upload(?:/)?$"
    },
    {
      "page": "/api/project-scope",
      "regex": "^/api/project\\-scope(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/project\\-scope(?:/)?$"
    },
    {
      "page": "/apple-icon.png",
      "regex": "^/apple\\-icon\\.png(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/apple\\-icon\\.png(?:/)?$"
    },
    {
      "page": "/categories",
      "regex": "^/categories(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/categories(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/invoices",
      "regex": "^/invoices(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/invoices(?:/)?$"
    },
    {
      "page": "/invoices/upload",
      "regex": "^/invoices/upload(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/invoices/upload(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/manifest.webmanifest",
      "regex": "^/manifest\\.webmanifest(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/manifest\\.webmanifest(?:/)?$"
    },
    {
      "page": "/materials",
      "regex": "^/materials(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/materials(?:/)?$"
    },
    {
      "page": "/payments",
      "regex": "^/payments(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/payments(?:/)?$"
    },
    {
      "page": "/projects",
      "regex": "^/projects(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/projects(?:/)?$"
    },
    {
      "page": "/users",
      "regex": "^/users(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/users(?:/)?$"
    },
    {
      "page": "/vendors",
      "regex": "^/vendors(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/vendors(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}